# Variables de entorno (fuente: lib/core/secure_env.dart, vía envied)
# Copia a .env, edita y regenera: dart run build_runner build -d
# .env NO se commitea y NO se empaqueta. El generado ofuscado
# lib/core/secure_env.g.dart tampoco se commitea (se regenera en CI).
#
# | Variable                    | Default                              | Descripción                   |
# |-----------------------------|--------------------------------------|-------------------------------|
# | ENV                         | dev                                  | dev \| prod                   |
# | DEV_BASE_URL                | http://127.0.0.1:3000                | API dev (iOS/desktop)         |
# | DEV_BASE_URL_ANDROID        | http://10.0.2.2:3000                 | API dev (emulador Android)    |
# | PROD_BASE_URL               | — (vacío si falta)                   | API prod (https)              |
# | PROD_BASE_URL_ANDROID       | = PROD_BASE_URL                      | Override Android prod         |
# | TERMS_URL                   | https://refer.cobyzero.com/terms     | Términos del Servicio         |
# | PRIVACY_URL                 | https://refer.cobyzero.com/privacy   | Política de Privacidad        |
# | STRIPE_PUBLISHABLE_KEY      | — (falla en voz alta si falta)       | Key pública Stripe (pk_...)   |
# | STRIPE_MERCHANT_IDENTIFIER  | merchant.com.example.refer_app       | Apple Pay merchant ID         |

ENV=dev

# Desarrollo (local)
DEV_BASE_URL=http://127.0.0.1:3000
DEV_BASE_URL_ANDROID=http://10.0.2.2:3000

# Producción
PROD_BASE_URL=https://refer-api.cobyzero.com
PROD_BASE_URL_ANDROID=https://refer-api.cobyzero.com

# Documentos legales
TERMS_URL=https://refer.cobyzero.com/terms
PRIVACY_URL=https://refer.cobyzero.com/privacy

STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_MERCHANT_IDENTIFIER=merchant.com.example.refer_app
